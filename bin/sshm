#!/usr/bin/env python3
"""
Interactive SSH Connection Manager (sshm)
A modern, robust TUI and CLI utility for managing and connecting to SSH hosts.
Features pixel-perfect responsive layout, real-time search, live latency probing, and host wizard.
"""

import sys
import os
import time
import socket
import select
import termios
import tty
import signal
import shutil
import re
import unicodedata
import subprocess
import concurrent.futures
from typing import List, Dict, Optional, Tuple

CONFIG_PATH = os.path.expanduser('~/.ssh/config')

# --- Color Palette (Aurora / Tokyo Night) ---
C_RESET    = '\033[0m'
C_BOLD     = '\033[1m'
C_DIM      = '\033[2m'
C_ITALIC   = '\033[3m'
C_UNDER    = '\033[4m'

# Aurora Tokyo Night accents
C_CYAN     = '\033[38;5;117m'  # Sky Blue / Soft Cyan
C_CYAN_B   = '\033[38;5;51m'   # Vibrant Electric Cyan
C_INDIGO   = '\033[38;5;141m'  # Lavender / Indigo
C_INDIGO_B = '\033[38;5;147m'  # Soft Light Indigo
C_EMERALD  = '\033[38;5;49m'   # Emerald / Mint Green
C_AMBER    = '\033[38;5;221m'  # Amber / Warm Gold
C_ROSE     = '\033[38;5;203m'  # Coral / Rose
C_SLATE    = '\033[38;5;240m'  # Slate (Dividers)
C_SLATE_L  = '\033[38;5;246m'  # Slate Gray (Muted text)
C_WHITE    = '\033[38;5;255m'  # Pure White

ANSI_RE = re.compile(r'\x1b\[[0-9;]*[a-zA-Z]')

def strip_ansi(s: str) -> str:
    return ANSI_RE.sub('', s)

def char_width(c: str) -> int:
    if unicodedata.category(c) in ('Mn', 'Me', 'Cc', 'Cf'):
        return 0
    if unicodedata.east_asian_width(c) in ('F', 'W'):
        return 2
    code = ord(c)
    if (0x1F300 <= code <= 0x1FAFF) or code in (
        0x2728, 0x2705, 0x274C, 0x26A1, 0x2600, 0x2601, 0x2614, 0x2615, 0x26BD, 0x26BE,
        0x26C4, 0x26C5, 0x26CF, 0x26D4, 0x26EA, 0x26F2, 0x26F3, 0x26F5, 0x26FA, 0x26FD
    ):
        return 2
    return 1

def str_width(s: str) -> int:
    clean = strip_ansi(s)
    return sum(char_width(c) for c in clean)

def pad_to_width(s: str, width: int, align: str = 'left') -> str:
    w = str_width(s)
    pad = max(0, width - w)
    if align == 'left':
        return s + (' ' * pad)
    elif align == 'right':
        return (' ' * pad) + s
    else:
        pad_l = pad // 2
        pad_r = pad - pad_l
        return (' ' * pad_l) + s + (' ' * pad_r)

def truncate_to_width(s: str, max_w: int) -> str:
    if str_width(s) <= max_w:
        return s
    res = []
    curr_w = 0
    for ch in s:
        cw = char_width(ch)
        if curr_w + cw + 1 > max_w:
            break
        res.append(ch)
        curr_w += cw
    return ''.join(res) + '…'

def clip_ansi_to_width(s: str, max_w: int) -> str:
    """Strictly truncates an ANSI colored string so visual width <= max_w without wrapping."""
    if str_width(s) <= max_w:
        return s
    res = []
    curr_w = 0
    i = 0
    n = len(s)
    while i < n:
        if s[i] == '\x1b':
            m = ANSI_RE.match(s, i)
            if m:
                res.append(m.group(0))
                i = m.end()
                continue
        cw = char_width(s[i])
        if curr_w + cw > max_w:
            break
        res.append(s[i])
        curr_w += cw
        i += 1
    return ''.join(res) + C_RESET


# --- SSH Config Parser ---

def parse_ssh_config(config_file: str = CONFIG_PATH) -> List[Dict[str, any]]:
    if not os.path.exists(config_file):
        return []
    
    hosts = []
    current_host = None
    
    try:
        with open(config_file, 'r') as f:
            for raw_line in f:
                line = raw_line.strip()
                if not line or line.startswith('#'):
                    continue
                
                parts = re.split(r'\s+|=', line, maxsplit=1)
                if not parts:
                    continue
                key = parts[0].lower()
                val = parts[1].strip() if len(parts) > 1 else ''
                
                if key == 'host':
                    aliases = val.split()
                    for alias in aliases:
                        if any(c in alias for c in '*?!'):
                            current_host = None
                            continue
                        current_host = {
                            'host': alias,
                            'hostname': alias,
                            'user': '',
                            'port': '22',
                            'proxyjump': '',
                            'identityfile': '',
                            'forwardagent': '',
                            'status': None,      # 'UP', 'DOWN', None
                            'latency': None      # '12.4ms'
                        }
                        hosts.append(current_host)
                elif current_host:
                    if key == 'hostname':
                        current_host['hostname'] = val
                    elif key == 'user':
                        current_host['user'] = val
                    elif key == 'port':
                        current_host['port'] = val
                    elif key == 'proxyjump':
                        current_host['proxyjump'] = val
                    elif key == 'identityfile':
                        current_host['identityfile'] = val
                    elif key == 'forwardagent':
                        current_host['forwardagent'] = val
    except Exception:
        pass
        
    return hosts


# --- Network Reachability Probing ---

def probe_single_host(host_dict: Dict[str, any], timeout: float = 2.0) -> Tuple[str, Optional[str]]:
    hostname = host_dict.get('hostname') or host_dict.get('host')
    port = 22
    try:
        port = int(host_dict.get('port') or 22)
    except Exception:
        pass

    t0 = time.time()
    try:
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.settimeout(timeout)
        sock.connect((hostname, port))
        elapsed_ms = (time.time() - t0) * 1000.0
        sock.close()
        return 'UP', f'{elapsed_ms:.1f}ms'
    except Exception:
        pass

    try:
        res = subprocess.run(['ping', '-c', '1', '-W', '1', hostname],
                             stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        if res.returncode == 0:
            m = re.search(r'time=([\d.]+)\s*ms', res.stdout)
            lat = f"{m.group(1)}ms" if m else "OK"
            return 'UP', lat
    except Exception:
        pass

    return 'DOWN', '-'

def probe_all_hosts_concurrently(hosts: List[Dict[str, any]], max_workers: int = 20) -> None:
    def _worker(h):
        status, latency = probe_single_host(h)
        h['status'] = status
        h['latency'] = latency
        return h

    with concurrent.futures.ThreadPoolExecutor(max_workers=max_workers) as executor:
        list(executor.map(_worker, hosts))


# --- Host Creation Wizard ---

def run_add_host_wizard() -> bool:
    print(f"\n{C_BOLD}{C_CYAN_B}✨ Add New SSH Host Wizard{C_RESET}")
    print(f"{C_SLATE_L}Fill in the details below (press Enter to accept defaults, Ctrl+C to cancel):{C_RESET}\n")

    current_user = os.getenv('USER', 'root')

    try:
        while True:
            alias = input(f"  {C_AMBER}▸{C_RESET} {C_WHITE}Host Alias / Name{C_RESET} (e.g. prod-web-01): ").strip()
            if not alias:
                print(f"    {C_ROSE}Host alias cannot be empty.{C_RESET}")
                continue
            if ' ' in alias:
                print(f"    {C_ROSE}Host alias cannot contain spaces.{C_RESET}")
                continue
            break

        while True:
            hostname = input(f"  {C_AMBER}▸{C_RESET} {C_WHITE}HostName / IP Address{C_RESET} (e.g. 192.168.1.100 or server.com): ").strip()
            if not hostname:
                print(f"    {C_ROSE}HostName / IP is required.{C_RESET}")
                continue
            break

        user_inp = input(f"  {C_AMBER}▸{C_RESET} {C_WHITE}User{C_RESET} [{C_EMERALD}{current_user}{C_RESET}]: ").strip()
        user = user_inp if user_inp else current_user

        port_inp = input(f"  {C_AMBER}▸{C_RESET} {C_WHITE}Port{C_RESET} [{C_EMERALD}22{C_RESET}]: ").strip()
        port = port_inp if port_inp else '22'

        jump = input(f"  {C_AMBER}▸{C_RESET} {C_WHITE}ProxyJump{C_RESET} (optional, e.g. bastion): ").strip()
        key = input(f"  {C_AMBER}▸{C_RESET} {C_WHITE}IdentityFile{C_RESET} (optional, e.g. ~/.ssh/id_rsa): ").strip()

        print(f"\n{C_BOLD}{C_CYAN}Configuration Preview:{C_RESET}")
        preview = f"\nHost {alias}\n    HostName {hostname}\n    User {user}\n    Port {port}"
        if jump:
            preview += f"\n    ProxyJump {jump}"
        if key:
            preview += f"\n    IdentityFile {key}"
        print(f"{C_INDIGO}{preview}{C_RESET}\n")

        confirm = input(f"  {C_AMBER}Save host to {CONFIG_PATH}? [Y/n]: {C_RESET}").strip().lower()
        if confirm and confirm not in ('y', 'yes'):
            print(f"  {C_ROSE}Cancelled.{C_RESET}\n")
            return False

        os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
        with open(CONFIG_PATH, 'a') as f:
            f.write(preview + "\n")
        os.chmod(CONFIG_PATH, 0o600)

        print(f"\n  {C_EMERALD}✔ Host '{alias}' successfully added to {CONFIG_PATH}!{C_RESET}\n")
        time.sleep(1.0)
        return True

    except KeyboardInterrupt:
        print(f"\n  {C_SLATE_L}Host creation cancelled.{C_RESET}\n")
        return False


# --- Editor Launcher ---

def open_config_in_editor():
    editor = os.getenv('EDITOR') or os.getenv('VISUAL')
    if not editor:
        for candidate in ['nano', 'vim', 'vi', 'code']:
            if shutil.which(candidate):
                editor = candidate
                break
    if not editor:
        editor = 'vi'

    os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
    if not os.path.exists(CONFIG_PATH):
        with open(CONFIG_PATH, 'w') as f:
            f.write("# SSH Config File\n")

    subprocess.run([editor, CONFIG_PATH])


# --- Key Reading & Terminal Sequences ---

TOKEN_RE = re.compile(
    r'('
    r'\x1b\[[0-9;:?]*[a-zA-Z~]'   # CSI sequence e.g. \x1b[A, \x1b[57441;5:1u, \x1b[15~, \x1b[?u
    r'|\x1bO[a-zA-Z]'            # SS3 sequence e.g. \x1bOP
    r'|\x1b[a-zA-Z0-9]'          # Alt sequence e.g. \x1bt, \x1bE
    r'|\x1b'                     # Standalone ESC
    r'|[\r\n]'                   # Enter
    r'|[\x00-\x1f\x7f]'          # Control characters e.g. \x00 (Ctrl+Space), \x14 (Ctrl+T)
    r'|[^\x00-\x1f\x7f\x1b]'     # Regular unicode character
    r')'
)

def parse_csi_u(seq: str) -> Optional[str]:
    """Parses Kitty Keyboard Protocol / CSI u escape sequences."""
    if not (seq.startswith('\x1b[') and seq.endswith('u')):
        return None
    body = seq[2:-1]
    parts = body.split(';')
    first = parts[0].split(':')
    try:
        keycode = int(first[0])
    except ValueError:
        return None

    # Event type defaults to 1 (press)
    event_type = 1
    if len(first) > 1:
        try:
            event_type = int(first[1])
        except ValueError:
            pass

    modifiers = 1
    if len(parts) > 1:
        mod_sub = parts[1].split(':')
        try:
            modifiers = int(mod_sub[0]) if mod_sub[0] else 1
        except ValueError:
            pass
        if len(mod_sub) > 1:
            try:
                event_type = int(mod_sub[1])
            except ValueError:
                pass

    # Modifier keys alone: Left Ctrl (57441), Right Ctrl (57442)
    if keycode in (57441, 57442):
        if event_type == 3:
            return 'CTRL_RELEASE'
        return 'CTRL_PRESS'

    # If any other non-modifier key is released, ignore the release event
    if event_type == 3:
        return 'KEY_RELEASE'

    ctrl = bool((modifiers - 1) & 4)
    alt = bool((modifiers - 1) & 2)

    if ctrl:
        if keycode in (ord('t'), ord('T'), 20): return 'CTRL_T'
        if keycode in (ord('p'), ord('P'), 16): return 'CTRL_P'
        if keycode in (ord('a'), ord('A'), 1): return 'CTRL_A'
        if keycode in (ord('e'), ord('E'), 5): return 'CTRL_E'
        if keycode in (ord('r'), ord('R'), 18): return 'CTRL_R'
        if keycode in (ord('c'), ord('C'), 3): return 'CTRL_C'
        if keycode in (ord('u'), ord('U'), 21): return 'CTRL_U'
        if keycode in (ord('n'), ord('N'), 14): return 'CTRL_N'
        if keycode in (ord('d'), ord('D'), 4): return 'CTRL_D'
        if keycode == 32: return 'CTRL_SPACE'
        if keycode in (ord('/'), 31): return 'CTRL_SLASH'

    if alt:
        if keycode in (ord('t'), ord('T')): return 'ALT_T'
        if keycode in (ord('p'), ord('P')): return 'ALT_P'
        if keycode in (ord('a'), ord('A')): return 'ALT_A'
        if keycode in (ord('e'), ord('E')): return 'ALT_E'
        if keycode in (ord('r'), ord('R')): return 'ALT_R'

    # Standard functional keys in CSI u
    if keycode in (13,): return 'ENTER'
    if keycode in (27,): return 'ESC'
    if keycode in (127, 8): return 'BACKSPACE'
    if keycode in (9,): return 'TAB'
    if keycode in (57373,): return 'UP'
    if keycode in (57374,): return 'DOWN'
    if keycode in (57375,): return 'RIGHT'
    if keycode in (57376,): return 'LEFT'
    if keycode in (57377,): return 'PAGEUP'
    if keycode in (57378,): return 'PAGEDOWN'
    if keycode in (57379,): return 'HOME'
    if keycode in (57380,): return 'END'
    if keycode in (57382,): return 'DELETE'
    if keycode in (57364,): return 'F1'
    if keycode in (57365,): return 'F2'
    if keycode in (57366,): return 'F3'
    if keycode in (57367,): return 'F4'
    if keycode in (57368,): return 'F5'

    # Plain printable text
    if not ctrl and not alt and 32 <= keycode <= 0x10FFFF:
        try:
            return chr(keycode)
        except Exception:
            pass

    return ''

def token_to_key(token: str) -> str:
    """Converts a raw token string into an action key name or character."""
    if not token:
        return ''
    if token.startswith('\x1b[') and token.endswith('u'):
        parsed = parse_csi_u(token)
        if parsed is not None:
            return parsed

    if token in ('\x1b[A', '\x1bOA'): return 'UP'
    if token in ('\x1b[B', '\x1bOB'): return 'DOWN'
    if token in ('\x1b[C', '\x1bOC'): return 'RIGHT'
    if token in ('\x1b[D', '\x1bOD'): return 'LEFT'
    if token in ('\x1b[H', '\x1b[1~', '\x1bOH'): return 'HOME'
    if token in ('\x1b[F', '\x1b[4~', '\x1bOF'): return 'END'
    if token == '\x1b[5~': return 'PAGEUP'
    if token == '\x1b[6~': return 'PAGEDOWN'
    if token == '\x1b[3~': return 'DELETE'
    if token == '\x1b[2~': return 'INSERT'
    if token in ('\x1bOP', '\x1b[11~', '\x1b[1;5P', '\x1b[1;5~'): return 'F1'
    if token in ('\x1bOQ', '\x1b[12~'): return 'F2'
    if token in ('\x1bOR', '\x1b[13~'): return 'F3'
    if token in ('\x1bOS', '\x1b[14~'): return 'F4'
    if token == '\x1b[15~': return 'F5'
    if token in ('\x1bt', '\x1bT'): return 'ALT_T'
    if token in ('\x1bp', '\x1bP', '\x1b[20;6~', '\x1b[84;5u', '\x1b[84;6u'): return 'ALT_P'
    if token in ('\x1ba', '\x1bA'): return 'ALT_A'
    if token in ('\x1be', '\x1bE'): return 'ALT_E'
    if token in ('\x1br', '\x1bR'): return 'ALT_R'
    if token == '\x1b': return 'ESC'

    # Control chars (C0)
    if token in ('\r', '\n'): return 'ENTER'
    if token in ('\x7f', '\x08'): return 'BACKSPACE'
    if token == '\x00': return 'CTRL_SPACE'
    if token == '\x1f': return 'CTRL_SLASH'
    if token == '\x01': return 'CTRL_A'
    if token == '\x03': return 'CTRL_C'
    if token == '\x04': return 'CTRL_D'
    if token == '\x05': return 'CTRL_E'
    if token == '\x0e': return 'CTRL_N'
    if token == '\x10': return 'CTRL_P'
    if token == '\x12': return 'CTRL_R'
    if token == '\x14': return 'CTRL_T'
    if token == '\x15': return 'CTRL_U'
    if token == '\t': return 'TAB'

    return token

_KEY_QUEUE: List[str] = []

def get_keypress(fd: int) -> str:
    """Reads a single key or complete multi-byte ANSI escape sequence."""
    global _KEY_QUEUE
    if _KEY_QUEUE:
        return _KEY_QUEUE.pop(0)

    try:
        raw_bytes = os.read(fd, 64)
    except KeyboardInterrupt:
        return 'CTRL_C'
    if not raw_bytes:
        return ''

    ch = raw_bytes.decode('latin1', errors='ignore')
    if not ch:
        return ''

    # If first char is ESC and sequence might be incomplete, wait briefly for remaining bytes
    if ch == '\x1b' or (ch.startswith('\x1b') and len(ch) >= 2 and not (ch.endswith('~') or (len(ch) >= 3 and ch[-1].isalpha()))):
        r, _, _ = select.select([fd], [], [], 0.04)
        if r:
            more = os.read(fd, 128).decode('latin1', errors='ignore')
            ch += more

    tokens = TOKEN_RE.findall(ch)
    if not tokens:
        return ''

    keys = []
    for t in tokens:
        k = token_to_key(t)
        if k:
            keys.append(k)

    if not keys:
        return ''

    _KEY_QUEUE.extend(keys[1:])
    return keys[0]


# --- Interactive TUI Runner ---

class SSHMenuApp:
    def __init__(self, initial_filter: str = ''):
        self.all_hosts = parse_ssh_config()
        self.filter_text = initial_filter
        self.selected_idx = 0
        self.scroll_offset = 0
        self.status_message = ''
        self.status_msg_time = 0
        self.running = True
        self.chosen_host = None
        self.ctrl_held = False
        self.ctrl_guide_latched = False

    def reload_hosts(self):
        saved_statuses = {h['host']: (h.get('status'), h.get('latency')) for h in self.all_hosts}
        self.all_hosts = parse_ssh_config()
        for h in self.all_hosts:
            if h['host'] in saved_statuses:
                h['status'], h['latency'] = saved_statuses[h['host']]

    def get_filtered_hosts(self) -> List[Dict[str, any]]:
        if not self.filter_text:
            return self.all_hosts
        terms = self.filter_text.strip().lower().split()
        if not terms:
            return self.all_hosts
        return [
            h for h in self.all_hosts
            if all(
                t in h['host'].lower()
                or t in h.get('hostname', '').lower()
                or t in h.get('user', '').lower()
                or t in h.get('proxyjump', '').lower()
                for t in terms
            )
        ]

    def set_toast(self, msg: str):
        self.status_message = msg
        self.status_msg_time = time.time()

    def test_selected_host(self):
        filtered = self.get_filtered_hosts()
        if not filtered:
            return
        target = filtered[self.selected_idx]
        self.set_toast(f"Probing {target['host']}...")
        self.render()
        status, latency = probe_single_host(target, timeout=2.0)
        target['status'] = status
        target['latency'] = latency
        if status == 'UP':
            self.set_toast(f"✔ {target['host']} is ONLINE ({latency})")
        else:
            self.set_toast(f"✖ {target['host']} is UNREACHABLE")

    def test_all_visible_hosts(self):
        filtered = self.get_filtered_hosts()
        if not filtered:
            return
        self.set_toast(f"Probing {len(filtered)} hosts concurrently...")
        self.render()
        probe_all_hosts_concurrently(filtered)
        online_count = sum(1 for h in filtered if h.get('status') == 'UP')
        self.set_toast(f"Probe completed: {online_count}/{len(filtered)} hosts ONLINE")

    def render(self):
        term_w, term_h = shutil.get_terminal_size((80, 24))
        filtered = self.get_filtered_hosts()

        if not filtered:
            self.selected_idx = 0
            self.scroll_offset = 0
        else:
            self.selected_idx = max(0, min(len(filtered) - 1, self.selected_idx))

        # Absolute max width allowed for any line (strictly prevents right-edge auto-wrap)
        max_w = max(40, term_w - 1)

        # Max list rows
        max_visible_rows = max(4, term_h - 9)

        if self.selected_idx < self.scroll_offset:
            self.scroll_offset = self.selected_idx
        elif self.selected_idx >= self.scroll_offset + max_visible_rows:
            self.scroll_offset = self.selected_idx - max_visible_rows + 1

        # Strict column widths calculation
        col_port = 5
        col_user = min(12, max(8, int((max_w - 35) * 0.18)))
        col_stat = 11

        # Exact items: 2 (lead/ptr) + 3 (#) + 5 gaps of 2 (10) = 15
        fixed = 15 + col_stat + col_user + col_port
        rem = max(16, max_w - fixed)
        col_host = int(rem * 0.52)
        col_ip   = rem - col_host

        div = f"{C_SLATE}{'─' * max_w}{C_RESET}"

        buf = []

        # 1. Header Line
        title_l = f"  {C_BOLD}{C_CYAN_B}🚀 SSH Connection Manager{C_RESET} {C_SLATE_L}(sshm){C_RESET}"
        count_r = f"{C_INDIGO_B}{len(filtered)} / {len(self.all_hosts)} hosts{C_RESET}"
        gap1 = max(2, max_w - str_width(title_l) - str_width(count_r))
        buf.append(f"{title_l}{' ' * gap1}{count_r}")

        # 2. Search Bar Line
        prompt = f"  {C_AMBER}🔍 Search:{C_RESET} "
        if self.filter_text:
            search_val = f"{C_BOLD}{C_WHITE}{self.filter_text}{C_RESET}{C_CYAN}█{C_RESET}"
            hint = f"{C_SLATE_L}[Esc / Ctrl+U to clear]{C_RESET}"
        else:
            search_val = f"{C_SLATE_L}Type to filter hosts (e.g. stage, dmz, root)...{C_RESET}"
            hint = f"{C_SLATE_L}[Ctrl: hold for actions / Ctrl+Space]{C_RESET}" if max_w >= 85 else ""
        left_search = prompt + search_val
        gap2 = max(2, max_w - str_width(left_search) - str_width(hint))
        buf.append(f"{left_search}{' ' * gap2}{hint}")
        buf.append(div)

        # 3. Table Header
        th_num  = pad_to_width("#", 3)
        th_stat = pad_to_width("STATUS", col_stat)
        th_host = pad_to_width(truncate_to_width("HOST ALIAS", col_host), col_host)
        th_ip   = pad_to_width(truncate_to_width("DESTINATION / IP", col_ip), col_ip)
        th_user = pad_to_width(truncate_to_width("USER", col_user), col_user)
        th_port = pad_to_width("PORT", col_port)

        th_line  = f"  {C_BOLD}{C_WHITE}{th_num}  {th_stat}  {th_host}  {th_ip}  {th_user}  {th_port}{C_RESET}"
        sep_line = f"  {C_SLATE}{'─'*3}  {'─'*col_stat}  {'─'*col_host}  {'─'*col_ip}  {'─'*col_user}  {'─'*col_port}{C_RESET}"
        buf.append(th_line)
        buf.append(sep_line)

        # 4. Table Rows
        visible_slice = filtered[self.scroll_offset : self.scroll_offset + max_visible_rows]
        if not visible_slice:
            buf.append(f"  {C_ROSE}No matching SSH hosts found for: '{self.filter_text}'{C_RESET}")
            for _ in range(max_visible_rows - 1):
                buf.append("")
        else:
            for idx_offset, h in enumerate(visible_slice):
                actual_idx = self.scroll_offset + idx_offset
                is_sel = (actual_idx == self.selected_idx)
                row_num = str(actual_idx + 1)

                h_host_raw = h['host']
                if 'live' in h_host_raw.lower():
                    h_host_raw += " [LIVE]"
                h_host = truncate_to_width(h_host_raw, col_host)
                h_ip   = truncate_to_width(h.get('hostname', '-'), col_ip)
                h_user = truncate_to_width(h.get('user', '-') or '-', col_user)
                h_port = truncate_to_width(str(h.get('port', '22')), col_port)

                # Status Badge
                stat = h.get('status')
                lat  = h.get('latency')
                if stat == 'UP':
                    stat_badge = f"{C_EMERALD}● {lat or 'UP'}{C_RESET}"
                elif stat == 'DOWN':
                    stat_badge = f"{C_ROSE}○ OFFLINE{C_RESET}"
                else:
                    stat_badge = f"{C_SLATE_L}· untried{C_RESET}"

                c_stat = pad_to_width(stat_badge, col_stat)
                c_num  = pad_to_width(row_num, 3)

                if is_sel:
                    ptr = f"{C_AMBER}▸{C_RESET} "
                    c_num_str  = f"{C_AMBER}{c_num}{C_RESET}"
                    c_host_str = f"{C_BOLD}{C_CYAN_B}{pad_to_width(h_host, col_host)}{C_RESET}"
                    c_ip_str   = f"{C_CYAN}{pad_to_width(h_ip, col_ip)}{C_RESET}"
                    c_user_str = f"{C_AMBER}{pad_to_width(h_user, col_user)}{C_RESET}"
                    c_port_str = f"{C_SLATE_L}{pad_to_width(h_port, col_port)}{C_RESET}"
                else:
                    ptr = "  "
                    c_num_str  = f"{C_SLATE_L}{c_num}{C_RESET}"
                    c_host_str = f"{C_WHITE}{pad_to_width(h_host, col_host)}{C_RESET}"
                    c_ip_str   = f"{C_CYAN}{pad_to_width(h_ip, col_ip)}{C_RESET}"
                    c_user_str = f"{C_SLATE_L}{pad_to_width(h_user, col_user)}{C_RESET}"
                    c_port_str = f"{C_SLATE_L}{pad_to_width(h_port, col_port)}{C_RESET}"

                row_str = f"{ptr}{c_num_str}  {c_stat}  {c_host_str}  {c_ip_str}  {c_user_str}  {c_port_str}"
                buf.append(row_str)

            for _ in range(max_visible_rows - len(visible_slice)):
                buf.append("")

        buf.append(div)

        is_ctrl_active = self.ctrl_held or self.ctrl_guide_latched

        # 5. Selected Host Detail / Toast Bar / Ctrl Indicator
        now = time.time()
        if is_ctrl_active:
            lbl = "CTRL HELD" if self.ctrl_held else "CTRL ACTIONS"
            badge = f"{C_BOLD}{C_AMBER}⚡ [{lbl}]{C_RESET}"
            if max_w >= 106:
                detail_line = (
                    f"  {badge} {C_WHITE}Next key:{C_RESET} "
                    f"{C_EMERALD}[T]{C_WHITE} Test{C_RESET}  "
                    f"{C_EMERALD}[P]{C_WHITE} Test All{C_RESET}  "
                    f"{C_AMBER}[A]{C_WHITE} Add{C_RESET}  "
                    f"{C_INDIGO}[E]{C_WHITE} Edit{C_RESET}  "
                    f"{C_CYAN}[R]{C_WHITE} Reload{C_RESET}  "
                    f"{C_SLATE_L}[U]{C_WHITE} Clear{C_RESET}  "
                    f"{C_ROSE}[Esc]{C_WHITE} Cancel{C_RESET}"
                )
            elif max_w >= 78:
                detail_line = (
                    f"  {badge} {C_WHITE}Next key:{C_RESET} "
                    f"{C_EMERALD}[T]{C_WHITE} Test{C_RESET}  "
                    f"{C_EMERALD}[P]{C_WHITE} All{C_RESET}  "
                    f"{C_AMBER}[A]{C_WHITE} Add{C_RESET}  "
                    f"{C_INDIGO}[E]{C_WHITE} Edit{C_RESET}  "
                    f"{C_CYAN}[R]{C_WHITE} Reload{C_RESET}"
                )
            else:
                detail_line = (
                    f"  {badge} "
                    f"{C_EMERALD}[T]{C_WHITE} Test{C_RESET} "
                    f"{C_EMERALD}[P]{C_WHITE} All{C_RESET} "
                    f"{C_AMBER}[A]{C_WHITE} Add{C_RESET} "
                    f"{C_INDIGO}[E]{C_WHITE} Edit{C_RESET}"
                )
        elif self.status_message and (now - self.status_msg_time < 5.0):
            detail_line = f"  {C_AMBER}⚡ {self.status_message}{C_RESET}"
        elif filtered:
            sel = filtered[self.selected_idx]
            u = sel.get('user') or os.getenv('USER', 'user')
            ip = sel.get('hostname', '-')
            p = sel.get('port', '22')
            dest = f"{u}@{ip}:{p}"
            jump = sel.get('proxyjump', '')
            jump_info = f" {C_INDIGO}(via {jump}){C_RESET}" if jump else ""
            key_info = f" {C_SLATE_L}[key: {os.path.basename(sel['identityfile'])}]{C_RESET}" if sel.get('identityfile') else ""
            caution = f" {C_BOLD}{C_ROSE}[⚠️ CAUTION: LIVE SERVER]{C_RESET}" if 'live' in sel['host'].lower() else ""
            detail_line = f"  {C_SLATE_L}💡 Selected: {C_BOLD}{C_WHITE}{sel['host']}{C_RESET} {C_SLATE_L}→{C_RESET} {C_CYAN}{dest}{C_RESET}{jump_info}{key_info}{caution}"
        else:
            detail_line = f"  {C_SLATE_L}No server selected{C_RESET}"

        buf.append(detail_line)

        # 6. Shortcut Keys Footer
        if is_ctrl_active:
            ctrl_prefix = f"{C_BOLD}{C_AMBER}[Ctrl] HELD ▸{C_RESET}" if self.ctrl_held else f"{C_BOLD}{C_AMBER}[Ctrl] GUIDE ▸{C_RESET}"
            if max_w >= 92:
                hk_t = f"{C_EMERALD}[T]{C_RESET} Test"
                hk_p = f"{C_EMERALD}[P]{C_RESET} Test All"
                hk_a = f"{C_AMBER}[A]{C_RESET} Add"
                hk_e = f"{C_INDIGO}[E]{C_RESET} Edit"
                hk_r = f"{C_CYAN}[R]{C_RESET} Reload"
                hk_u = f"{C_SLATE_L}[U]{C_RESET} Clear"
                hk_esc = f"{C_ROSE}[Esc]{C_RESET} Cancel"
                hk_all = f"  {ctrl_prefix}  {hk_t}  {hk_p}  {hk_a}  {hk_e}  {hk_r}  {hk_u}  {hk_esc}"
            elif max_w >= 75:
                hk_t = f"{C_EMERALD}[T]{C_RESET} Test"
                hk_p = f"{C_EMERALD}[P]{C_RESET} All"
                hk_a = f"{C_AMBER}[A]{C_RESET} Add"
                hk_e = f"{C_INDIGO}[E]{C_RESET} Edit"
                hk_r = f"{C_CYAN}[R]{C_RESET} Reload"
                hk_esc = f"{C_ROSE}[Esc]{C_RESET} Exit"
                hk_all = f"  {ctrl_prefix}  {hk_t}  {hk_p}  {hk_a}  {hk_e}  {hk_r}  {hk_esc}"
            else:
                hk_t = f"{C_EMERALD}[T]{C_RESET} Test"
                hk_p = f"{C_EMERALD}[P]{C_RESET} All"
                hk_a = f"{C_AMBER}[A]{C_RESET} Add"
                hk_e = f"{C_INDIGO}[E]{C_RESET} Edit"
                hk_r = f"{C_CYAN}[R]{C_RESET} Reload"
                hk_all = f"  {C_BOLD}{C_AMBER}[Ctrl]▸{C_RESET} {hk_t} {hk_p} {hk_a} {hk_e} {hk_r}"
        else:
            # Standard footer - ALWAYS use Ctrl+ (never ^)
            if max_w >= 90:
                hk1 = f"{C_CYAN}[Enter]{C_RESET} Connect"
                hk2 = f"{C_EMERALD}[Ctrl+T]{C_RESET} Test"
                hk3 = f"{C_EMERALD}[Ctrl+P]{C_RESET} Test All"
                hk4 = f"{C_AMBER}[Ctrl+A]{C_RESET} Add"
                hk5 = f"{C_INDIGO}[Ctrl+E]{C_RESET} Edit"
                hk6 = f"{C_ROSE}[Esc]{C_RESET} Quit"
                hk_all = f"  {hk1}  {hk2}  {hk3}  {hk4}  {hk5}  {hk6}"
            elif max_w >= 78:
                hk1 = f"{C_CYAN}[Enter]{C_RESET} Conn"
                hk2 = f"{C_EMERALD}[Ctrl+T]{C_RESET} Test"
                hk3 = f"{C_EMERALD}[Ctrl+P]{C_RESET} All"
                hk4 = f"{C_AMBER}[Ctrl+A]{C_RESET} Add"
                hk5 = f"{C_INDIGO}[Ctrl+E]{C_RESET} Edit"
                hk6 = f"{C_ROSE}[Esc]{C_RESET} Quit"
                hk_all = f"  {hk1} {hk2} {hk3} {hk4} {hk5} {hk6}"
            else:
                hk1 = f"{C_CYAN}[Enter]{C_RESET} Conn"
                hk2 = f"{C_EMERALD}[Ctrl+T]{C_RESET} Test"
                hk3 = f"{C_EMERALD}[Ctrl+P]{C_RESET} All"
                hk4 = f"{C_AMBER}[Ctrl+A]{C_RESET} Add"
                hk5 = f"{C_INDIGO}[Ctrl+E]{C_RESET} Edit"
                hk_all = f"  {hk1} {hk2} {hk3} {hk4} {hk5}"
        buf.append(hk_all)

        # Home cursor and write each strictly-clipped line
        output_buffer = ['\033[H']
        for line in buf:
            clipped = clip_ansi_to_width(line, max_w)
            output_buffer.append(f"\r\033[K{clipped}")
        
        sys.stdout.write('\r\n'.join(output_buffer) + '\r\n')
        sys.stdout.flush()

    def run(self) -> Optional[str]:
        fd = sys.stdin.fileno()
        old_settings = termios.tcgetattr(fd)
        new_settings = termios.tcgetattr(fd)
        new_settings[3] &= ~(termios.ICANON | termios.ECHO)

        def _on_resize(signum, frame):
            self.render()

        signal.signal(signal.SIGWINCH, _on_resize)

        try:
            termios.tcsetattr(fd, termios.TCSADRAIN, new_settings)
            # Enter alternate screen, hide cursor, clear screen, and request Kitty Keyboard Protocol
            # Flag 11 = Disambiguate (1) + Report Event Types (2) + Report All Keys as Escape Codes (8)
            sys.stdout.write('\033[?1049h\033[?25l\033[2J\033[>11u')
            sys.stdout.flush()

            self.render()

            while self.running:
                key = get_keypress(fd)
                if not key:
                    continue

                if key == 'KEY_RELEASE':
                    continue

                if key == 'CTRL_PRESS':
                    self.ctrl_held = True
                    self.render()
                    continue

                elif key == 'CTRL_RELEASE':
                    self.ctrl_held = False
                    self.render()
                    continue

                elif key in ('CTRL_SPACE', 'CTRL_SLASH', 'F1'):
                    self.ctrl_guide_latched = not self.ctrl_guide_latched
                    self.render()
                    continue

                # If holding Ctrl or guide is latched, map single-letter actions
                if self.ctrl_held or self.ctrl_guide_latched:
                    if key in ('t', 'T'): key = 'CTRL_T'
                    elif key in ('p', 'P'): key = 'CTRL_P'
                    elif key in ('a', 'A', 'n', 'N'): key = 'CTRL_A'
                    elif key in ('e', 'E'): key = 'CTRL_E'
                    elif key in ('r', 'R'): key = 'CTRL_R'
                    elif key in ('u', 'U'): key = 'CTRL_U'
                    elif key in ('c', 'C'): key = 'CTRL_C'

                filtered = self.get_filtered_hosts()
                num_items = len(filtered)

                if key in ('CTRL_C', 'CTRL_D'):
                    self.chosen_host = None
                    break

                elif key == 'ESC':
                    if self.ctrl_guide_latched:
                        self.ctrl_guide_latched = False
                        self.render()
                    elif self.filter_text:
                        self.filter_text = ''
                        self.selected_idx = 0
                        self.render()
                    else:
                        self.chosen_host = None
                        break

                elif key == 'UP':
                    if num_items > 0:
                        self.selected_idx = (self.selected_idx - 1) % num_items
                    self.render()

                elif key == 'DOWN':
                    if num_items > 0:
                        self.selected_idx = (self.selected_idx + 1) % num_items
                    self.render()

                elif key == 'PAGEUP':
                    if num_items > 0:
                        self.selected_idx = max(0, self.selected_idx - 5)
                    self.render()

                elif key == 'PAGEDOWN':
                    if num_items > 0:
                        self.selected_idx = min(num_items - 1, self.selected_idx + 5)
                    self.render()

                elif key == 'HOME':
                    self.selected_idx = 0
                    self.render()

                elif key == 'END':
                    if num_items > 0:
                        self.selected_idx = num_items - 1
                    self.render()

                elif key == 'ENTER':
                    if filtered and 0 <= self.selected_idx < len(filtered):
                        self.chosen_host = filtered[self.selected_idx]['host']
                        break

                elif key == 'BACKSPACE':
                    if self.filter_text:
                        self.filter_text = self.filter_text[:-1]
                        self.selected_idx = 0
                    self.render()

                elif key == 'CTRL_U':
                    self.ctrl_guide_latched = False
                    self.filter_text = ''
                    self.selected_idx = 0
                    self.render()

                elif key in ('CTRL_T', 'ALT_T', 'F5'):
                    self.ctrl_guide_latched = False
                    self.test_selected_host()

                elif key in ('CTRL_P', 'ALT_P'):
                    self.ctrl_guide_latched = False
                    self.test_all_visible_hosts()

                elif key in ('CTRL_R', 'ALT_R'):
                    self.ctrl_guide_latched = False
                    self.reload_hosts()
                    self.set_toast("SSH configuration reloaded")
                    self.render()

                elif key in ('CTRL_A', 'CTRL_N', 'ALT_A', 'F2'):
                    self.ctrl_guide_latched = False
                    termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
                    sys.stdout.write('\033[<u\033[?1049l\033[?25h')
                    sys.stdout.flush()

                    run_add_host_wizard()

                    termios.tcsetattr(fd, termios.TCSADRAIN, new_settings)
                    sys.stdout.write('\033[?1049h\033[?25l\033[2J\033[>11u')
                    sys.stdout.flush()
                    self.reload_hosts()
                    self.render()

                elif key in ('CTRL_E', 'ALT_E', 'F4'):
                    self.ctrl_guide_latched = False
                    termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
                    sys.stdout.write('\033[<u\033[?1049l\033[?25h')
                    sys.stdout.flush()

                    open_config_in_editor()

                    termios.tcsetattr(fd, termios.TCSADRAIN, new_settings)
                    sys.stdout.write('\033[?1049h\033[?25l\033[2J\033[>11u')
                    sys.stdout.flush()
                    self.reload_hosts()
                    self.set_toast("SSH config updated from editor")
                    self.render()

                elif len(key) == 1 and key.isprintable() and not (self.ctrl_held or self.ctrl_guide_latched):
                    self.filter_text += key
                    self.selected_idx = 0
                    self.render()

        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
            sys.stdout.write('\033[<u\033[?1049l\033[?25h\033[0m')
            sys.stdout.flush()

        return self.chosen_host


# --- Subcommand Actions ---

def list_hosts_table(filter_str: str = ''):
    hosts = parse_ssh_config()
    if not hosts:
        print(f"\n{C_ROSE}No hosts found in {CONFIG_PATH}{C_RESET}\n")
        return

    if filter_str:
        q = filter_str.lower()
        hosts = [h for h in hosts if q in h['host'].lower() or q in h['hostname'].lower() or q in h['user'].lower()]

    print(f"\n  {C_BOLD}{C_CYAN_B}📋 Configured SSH Hosts{C_RESET}  {C_SLATE_L}({len(hosts)} hosts in {CONFIG_PATH}){C_RESET}\n")
    print(f"     {C_BOLD}{C_WHITE}{'#':<3}  {'HOST ALIAS':<24}  {'DESTINATION / IP':<18}  {'USER':<12}  {'PORT':<6}  {'PROXY / NOTES'}{C_RESET}")
    print(f"     {C_SLATE}{'─'*3}  {'─'*24}  {'─'*18}  {'─'*12}  {'─'*6}  {'─'*20}{C_RESET}")

    for idx, h in enumerate(hosts, 1):
        host_str = h['host']
        if 'live' in host_str.lower():
            host_str += " [LIVE]"
        ip_str   = h.get('hostname', '-')
        user_str = h.get('user', '-') or '-'
        port_str = str(h.get('port', '22'))
        jump     = h.get('proxyjump', '')
        note     = f"via {jump}" if jump else "-"

        print(f"     {C_AMBER}{idx:<3}{C_RESET}  {C_BOLD}{C_WHITE}{host_str:<24}{C_RESET}  {C_CYAN}{ip_str:<18}{C_RESET}  {C_EMERALD}{user_str:<12}{C_RESET}  {C_SLATE_L}{port_str:<6}{C_RESET}  {C_INDIGO}{note}{C_RESET}")
    print()

def test_hosts_cli(filter_str: str = ''):
    hosts = parse_ssh_config()
    if not hosts:
        print(f"\n{C_ROSE}No hosts found in {CONFIG_PATH}{C_RESET}\n")
        return

    if filter_str:
        q = filter_str.lower()
        hosts = [h for h in hosts if q in h['host'].lower() or q in h['hostname'].lower()]

    print(f"\n  {C_BOLD}{C_CYAN_B}⚡ Testing Reachability for {len(hosts)} SSH Host(s)...{C_RESET}\n")
    print(f"     {C_BOLD}{C_WHITE}{'#':<3}  {'STATUS':<12}  {'LATENCY':<10}  {'HOST ALIAS':<24}  {'DESTINATION / IP':<18}  {'PORT'}{C_RESET}")
    print(f"     {C_SLATE}{'─'*3}  {'─'*12}  {'─'*10}  {'─'*24}  {'─'*18}  {'─'*6}{C_RESET}")

    t0 = time.time()
    probe_all_hosts_concurrently(hosts)
    total_time = time.time() - t0
    online_count = 0

    for idx, h in enumerate(hosts, 1):
        status = h.get('status', 'DOWN')
        lat    = h.get('latency', '-')
        if status == 'UP':
            status_disp = f"{C_EMERALD}● ONLINE{C_RESET}"
            lat_disp    = f"{C_EMERALD}{lat}{C_RESET}"
            online_count += 1
        else:
            status_disp = f"{C_ROSE}○ OFFLINE{C_RESET}"
            lat_disp    = f"{C_SLATE_L}-{C_RESET}"

        s_col  = pad_to_width(status_disp, 12)
        l_col  = pad_to_width(lat_disp, 10)
        host_str = h['host']
        if 'live' in host_str.lower():
            host_str += " [LIVE]"
        h_col  = pad_to_width(host_str, 24)
        ip_col = pad_to_width(h.get('hostname', '-'), 18)
        p_col  = str(h.get('port', 22))

        print(f"     {C_AMBER}{idx:<3}{C_RESET}  {s_col}  {l_col}  {C_BOLD}{C_WHITE}{h_col}{C_RESET}  {C_CYAN}{ip_col}{C_RESET}  {C_SLATE_L}{p_col}{C_RESET}")

    print(f"\n  {C_SLATE_L}Results: {C_EMERALD}{online_count}{C_SLATE_L}/{len(hosts)} hosts reachable (tested in {total_time:.2f}s).{C_RESET}\n")


def connect_ssh(host_alias: str):
    """Cleanly execs native SSH connection."""
    all_hosts = parse_ssh_config()
    matched = next((h for h in all_hosts if h['host'] == host_alias), None)
    if matched:
        u = matched.get('user') or os.getenv('USER', 'user')
        dest = matched.get('hostname', host_alias)
        p = matched.get('port', '22')
        if 'live' in host_alias.lower():
            print(f"\n{C_BOLD}{C_ROSE}⚠️  CAUTION: You are connecting to a LIVE production server!{C_RESET}")
        print(f"\n{C_BOLD}{C_CYAN_B}⚡ Connecting to {C_WHITE}{host_alias}{C_CYAN_B} ({u}@{dest}:{p})...{C_RESET}\n")
    else:
        if 'live' in host_alias.lower():
            print(f"\n{C_BOLD}{C_ROSE}⚠️  CAUTION: You are connecting to a LIVE production server!{C_RESET}")
        print(f"\n{C_BOLD}{C_CYAN_B}⚡ Connecting to {C_WHITE}{host_alias}{C_CYAN_B}...{C_RESET}\n")
    os.execvp('ssh', ['ssh', host_alias])


# --- Main Entry Point ---

def print_help():
    print(f"""
  {C_BOLD}{C_CYAN_B}🚀 sshm - Modern Interactive SSH Connection Manager{C_RESET}

  {C_BOLD}USAGE:{C_RESET}
      sshm                     Launch interactive TUI host manager & picker
      sshm <query>             Instant direct connect (if 1 match) or pre-filtered TUI
      sshm list, -l, ls        Display formatted table of all SSH hosts
      sshm test, -t [query]    Test reachability and latency for all hosts
      sshm add, -a             Launch interactive wizard to add a new host
      sshm edit, -e            Open ~/.ssh/config in your $EDITOR
      sshm --help, -h          Show this help message

  {C_BOLD}INTERACTIVE TUI KEYBINDINGS:{C_RESET}
      {C_CYAN}↑ / ↓, PgUp / PgDn{C_RESET}   Navigate server list
      {C_CYAN}[letters / numbers]{C_RESET} Real-time instant search by name, IP, user, or proxy
      {C_CYAN}Backspace / Ctrl+U{C_RESET}   Delete last char / clear filter
      {C_CYAN}Enter{C_RESET}                Connect to selected host via native ssh
      {C_CYAN}Ctrl (Hold){C_RESET}          Live indicator showing what key to press next
      {C_CYAN}Ctrl+Space / F1{C_RESET}      Toggle Ctrl actions guide & next-key indicator
      {C_CYAN}Ctrl+T (or Alt+T){C_RESET}    Test latency of selected host
      {C_CYAN}Ctrl+P (or Alt+P){C_RESET}    Test latency of all visible hosts
      {C_CYAN}Ctrl+A / Ctrl+N{C_RESET}      Add new host wizard
      {C_CYAN}Ctrl+E (or Alt+E){C_RESET}    Edit ~/.ssh/config in $EDITOR
      {C_CYAN}Ctrl+R (or Alt+R){C_RESET}    Reload SSH config
      {C_CYAN}Esc / Ctrl+C{C_RESET}         Exit picker cleanly (Esc clears filter if active)
""")

def main():
    args = sys.argv[1:]

    if not args:
        app = SSHMenuApp()
        try:
            host = app.run()
        except KeyboardInterrupt:
            host = None
        if host:
            connect_ssh(host)
        return

    cmd = args[0].lower()

    if cmd in ('-h', '--help', 'help'):
        print_help()
        return

    if cmd in ('-l', 'list', 'ls', '--list'):
        q = args[1] if len(args) > 1 else ''
        list_hosts_table(q)
        return

    if cmd in ('-t', 'test', '--test'):
        q = args[1] if len(args) > 1 else ''
        test_hosts_cli(q)
        return

    if cmd in ('-a', 'add', '--add'):
        run_add_host_wizard()
        return

    if cmd in ('-e', 'edit', '--edit'):
        open_config_in_editor()
        return

    query = cmd
    all_hosts = parse_ssh_config()
    q = query.lower()
    matches = [
        h for h in all_hosts
        if q in h['host'].lower()
        or q in h.get('hostname', '').lower()
        or q in h.get('user', '').lower()
    ]

    exact_matches = [h for h in all_hosts if h['host'].lower() == q]
    if len(exact_matches) == 1:
        connect_ssh(exact_matches[0]['host'])
        return

    if len(matches) == 1:
        connect_ssh(matches[0]['host'])
        return

    if len(matches) == 0:
        print(f"\n{C_ROSE}No SSH hosts found matching: '{query}'{C_RESET}")
        list_hosts_table()
        return

    app = SSHMenuApp(initial_filter=query)
    host = app.run()
    if host:
        connect_ssh(host)

if __name__ == '__main__':
    main()
