ANSI_RE = re.compile(r'\x1b\[[0-9;]*[a-zA-Z]')

def strip_ansi(s: str) -> str:
    return ANSI_RE.sub('', s)

def char_width(c: str) -> int:
    """Accurately calculates visual cell width for Unicode characters and emojis."""
    if unicodedata.category(c) in ('Mn', 'Me', 'Cc', 'Cf'):
        return 0
    if unicodedata.east_asian_width(c) in ('F', 'W'):
        return 2
    code = ord(c)
    if (0x1F300 <= code <= 0x1FAFF) or code in (
        0x2728, 0x2705, 0x274C, 0x26A1, 0x2600, 0x2601, 0x2614, 0x2615, 0x26BD, 0x26BE,
        0x26C4, 0x26C5, 0x26CF, 0x26D4, 0x26EA, 0x26F2, 0x26F3, 0x26F5, 0x26FA, 0x26FD
    ):
        return 2
    return 1

def str_width(s: str) -> int:
    clean = strip_ansi(s)
    return sum(char_width(c) for c in clean)

def pad_to_width(s: str, width: int, align: str = 'left') -> str:
    w = str_width(s)
    pad = max(0, width - w)
    if align == 'left':
        return s + (' ' * pad)
    elif align == 'right':
        return (' ' * pad) + s
    else:
        pad_l = pad // 2
        pad_r = pad - pad_l
        return (' ' * pad_l) + s + (' ' * pad_r)

def truncate_to_width(s: str, max_w: int) -> str:
    if str_width(s) <= max_w:
        return s
    res = []
    curr_w = 0
    for ch in s:
        cw = char_width(ch)
        if curr_w + cw + 1 > max_w:
            break
        res.append(ch)
        curr_w += cw
    return ''.join(res) + '…'

def make_gauge(pct: float, length: int = 8) -> str:
    pct = max(0.0, min(100.0, pct))
    filled = int(round(pct / 100.0 * length))
    empty = length - filled
    if pct >= 85:
        col = C_ROSE
    elif pct >= 65:
        col = C_AMBER
    else:
        col = C_EMERALD
    return f'[{col}{"■" * filled}{C_GRAY_BG}{"░" * empty}{C_RESET}]'

def get_cpu_percent(sample_ms: int = 40) -> float:
    try:
        def read_stat():
            with open('/proc/stat', 'r') as f:
                fields = [float(x) for x in f.readline().strip().split()[1:]]
                idle = fields[3] + (fields[4] if len(fields) > 4 else 0.0)
                total = sum(fields)
                return idle, total
        i1, t1 = read_stat()
        time.sleep(sample_ms / 1000.0)
        i2, t2 = read_stat()
        d_tot = t2 - t1
        d_idle = i2 - i1
        if d_tot > 0:
            return max(0.0, min(100.0, (1.0 - (d_idle / d_tot)) * 100.0))
    except Exception:
        pass
    try:
        l1 = os.getloadavg()[0]
        cores = os.cpu_count() or 1
        return max(0.0, min(100.0, (l1 / cores) * 100.0))
    except Exception:
        return 0.0

def get_cpu_temp() -> float:
    """Reads CPU temperature in °C from hwmon or thermal_zone."""
    try:
        for path in glob.glob('/sys/class/hwmon/hwmon*/temp*_input'):
            try:
                with open(path, 'r') as f:
                    val = float(f.read().strip()) / 1000.0
                    if 15.0 <= val <= 115.0:
                        return val
            except Exception:
                pass
        for path in glob.glob('/sys/class/thermal/thermal_zone*/temp'):
            try:
                with open(path, 'r') as f:
                    val = float(f.read().strip()) / 1000.0
                    if 15.0 <= val <= 115.0:
                        return val
            except Exception:
                pass
    except Exception:
        pass
    return None

def get_dynamic_greeting(user_display: str) -> str:
    hour = datetime.datetime.now().hour
    if 5 <= hour < 12:
        icon, greet = '🌅', 'Good morning'
    elif 12 <= hour < 17:
        icon, greet = '☀️', 'Good afternoon'
    elif 17 <= hour < 22:
        icon, greet = '🌆', 'Good evening'
    else:
        icon, greet = '🌙', 'Welcome back'
    return f"{icon} {greet}, {C_WHITE}{user_display}!{C_RESET}"

def get_git_info(cwd: str = None) -> dict:
    if cwd is None:
        cwd = os.getcwd()
    try:
        res = subprocess.run(['git', 'rev-parse', '--is-inside-work-tree'], cwd=cwd, capture_output=True, text=True, timeout=0.1)
        if res.returncode != 0 or 'true' not in res.stdout:
            return None
        branch = subprocess.run(['git', 'branch', '--show-current'], cwd=cwd, capture_output=True, text=True, timeout=0.1).stdout.strip() or 'HEAD'
        status_lines = subprocess.run(['git', 'status', '--porcelain'], cwd=cwd, capture_output=True, text=True, timeout=0.1).stdout.strip().splitlines()
        repo_name = os.path.basename(os.path.abspath(cwd))
        return {
            'repo': repo_name,
            'branch': branch,
            'dirty_count': len(status_lines)
        }
    except Exception:
        return None

def get_notes() -> list:
    if os.path.exists(NOTES_PATH):
        try:
            with open(NOTES_PATH, 'r') as f:
                lines = [l.strip() for l in f if l.strip() and not l.strip().startswith('#')]
                return lines
        except Exception:
            pass
    return []

def get_system_alerts() -> list:
    alerts = []
    if os.path.exists('/var/run/reboot-required'):
        alerts.append('🔄 Reboot required to complete system updates')
    try:
        res = subprocess.run(['systemctl', '--failed', '--quiet'], capture_output=True, timeout=0.1)
        if res.returncode != 0:
            lines_res = subprocess.run(['systemctl', '--failed', '--no-legend', '--plain'], capture_output=True, text=True, timeout=0.1)
            f_lines = [l for l in lines_res.stdout.strip().splitlines() if l.strip()]
            count = len(f_lines)
            if count > 0:
                alerts.append(f'⚠️  {count} failed system service{"s" if count > 1 else ""}')
    except Exception:
        pass
    return alerts

def ping_target(host_or_ip: str, timeout_sec: float = 0.5) -> float:
    try:
        res = subprocess.run(
            ['ping', '-c', '1', '-W', '1', host_or_ip],
            capture_output=True,
            text=True,
            timeout=timeout_sec + 0.3
        )
        if res.returncode == 0:
            match = re.search(r'time=([\d\.]+)\s*ms', res.stdout)
            if match:
                return float(match.group(1))
            return 1.0
    except Exception:
        pass
    return -1.0

DEFAULT_IPV6_IPS = {'::1', 'fe00::0', 'ff00::0', 'ff02::1', 'ff02::2', 'ff02::3'}
DEFAULT_HOSTNAMES = {
    'localhost', 'localhost.localdomain', 'localhost4', 'localhost4.localdomain4',
    'localhost6', 'localhost6.localdomain6', 'ip6-localhost', 'ip6-loopback',
    'ip6-localnet', 'ip6-mcastprefix', 'ip6-allnodes', 'ip6-allrouters', 'ip6-allhosts'
}

def is_ip(s: str) -> bool:
    """Checks if a string is a valid IPv4 address or IPv6 format."""
    if re.match(r'^\d{1,3}(\.\d{1,3}){3}$', s):
        return True
    if ':' in s and re.match(r'^[0-9a-fA-F:]+$', s):
        return True
    return False

def is_default_host(ip: str, domains: list, system_hostname: str) -> bool:
    """Determines whether a host mapping is part of default OS boilerplate or custom-added."""
    h_lower = system_hostname.lower()
    if ip == '127.0.0.1' and all(d.lower() in ('localhost', 'localhost.localdomain') for d in domains):
        return True
    if (ip.startswith('127.0.1.') or ip == '127.0.0.1') and all(d.lower() in ('localhost', h_lower) for d in domains):
        return True
    if ip in DEFAULT_IPV6_IPS and all(d.lower() in DEFAULT_HOSTNAMES or d.lower() == h_lower for d in domains):
        return True
    return False

def get_hosts_insights(path: str = '/etc/hosts') -> dict:
    """Parses /etc/hosts to extract custom active and disabled (commented) host overrides."""
    active_entries = []
    disabled_entries = []
    system_hostname = platform.node()

    if os.path.exists(path):
        try:
            with open(path, 'r') as f:
                for line in f:
                    raw = line.strip()
                    if not raw:
                        continue
                    # Check for commented-out host entries
                    if raw.startswith('#'):
                        comment_body = raw.lstrip('#').strip()
                        if not comment_body:
                            continue
                        parts = comment_body.split()
                        if len(parts) >= 2 and is_ip(parts[0]):
                            ip, domains = parts[0], parts[1:]
                            if not is_default_host(ip, domains, system_hostname):
                                disabled_entries.append({'ip': ip, 'domains': domains, 'raw': raw})
                        continue

                    # Active host entry (strip trailing comment)
                    if '#' in raw:
                        raw_active = raw.split('#', 1)[0].strip()
                    else:
                        raw_active = raw

                    parts = raw_active.split()
                    if len(parts) >= 2 and is_ip(parts[0]):
                        ip, domains = parts[0], parts[1:]
                        if not is_default_host(ip, domains, system_hostname):
                            active_entries.append({'ip': ip, 'domains': domains, 'raw': raw})
        except Exception:
            pass

    return {
        'active': active_entries,
        'disabled': disabled_entries,
        'active_count': len(active_entries),
        'disabled_count': len(disabled_entries)
    }

def get_system_stats():
    raw_user = os.getenv('USER') or os.getenv('LOGNAME') or 'user'
    name_display = raw_user.capitalize()

    distro = 'Linux'
    if os.path.exists('/etc/os-release'):
        try:
            with open('/etc/os-release', 'r') as f:
                for line in f:
                    if line.startswith('PRETTY_NAME='):
                        distro = line.split('=', 1)[1].strip().strip('\"')
                        break
        except Exception:
            pass

    arch = platform.machine()
    kernel = platform.release()
    hostname = platform.node()

    # CPU Model
    cpu_name = 'Unknown CPU'
    core_count = os.cpu_count() or 1
    try:
        with open('/proc/cpuinfo', 'r') as f:
            for line in f:
                if 'model name' in line:
                    raw = line.split(':', 1)[1].strip()
                    clean = re.sub(r'\s+', ' ', raw).replace('(R)', '').replace('(TM)', '').replace(' CPU', '').strip()
                    if ' @ ' in clean:
                        clean = clean.split(' @ ')[0].strip()
                    cpu_name = clean
                    break
    except Exception:
        pass

    # CPU Usage & Temp
    cpu_pct = get_cpu_percent(30)
    cpu_temp = get_cpu_temp()

    # Memory & Swap
    mem_info = {}
    try:
        with open('/proc/meminfo', 'r') as f:
            for line in f:
                parts = line.split(':')
                if len(parts) == 2:
                    mem_info[parts[0].strip()] = int(parts[1].strip().split()[0])
    except Exception:
        pass

    mem_total = mem_info.get('MemTotal', 0) / 1024 / 1024
    mem_avail = mem_info.get('MemAvailable', 0) / 1024 / 1024
    mem_used = max(0.0, mem_total - mem_avail)
    mem_pct = (mem_used / mem_total * 100) if mem_total > 0 else 0.0

    swap_total = mem_info.get('SwapTotal', 0) / 1024 / 1024
    swap_free = mem_info.get('SwapFree', 0) / 1024 / 1024
    swap_used = max(0.0, swap_total - swap_free)
    swap_pct = (swap_used / swap_total * 100) if swap_total > 0 else 0.0

    # Root Disk
    try:
        st = os.statvfs('/')
        disk_total = (st.f_blocks * st.f_frsize) / (1024**3)
        disk_free = (st.f_bavail * st.f_frsize) / (1024**3)
        disk_used = disk_total - disk_free
        disk_pct = (disk_used / disk_total * 100) if disk_total > 0 else 0.0
    except Exception:
        disk_total, disk_used, disk_pct = 0.0, 0.0, 0.0

    # Load Averages
    try:
        l1, l5, l15 = os.getloadavg()
    except Exception:
        l1, l5, l15 = 0.0, 0.0, 0.0

    # Uptime
    uptime_str = 'unknown'
    try:
        with open('/proc/uptime', 'r') as f:
            sec = float(f.readline().split()[0])
            d = int(sec // 86400)
            h = int((sec % 86400) // 3600)
            m = int((sec % 3600) // 60)
            if d > 0:
                uptime_str = f'{d}d {h}h {m}m'
            elif h > 0:
                uptime_str = f'{h}h {m}m'
            else:
                uptime_str = f'{m}m'
    except Exception:
        pass

    # Network IP
    lan_ip = '127.0.0.1'
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.settimeout(0.1)
        s.connect(('1.1.1.1', 80))
        lan_ip = s.getsockname()[0]
        s.close()
    except Exception:
        pass

    # SSH Hosts Count
    ssh_count = 0
    ssh_config_path = os.path.expanduser('~/.ssh/config')
    if os.path.exists(ssh_config_path):
        try:
            with open(ssh_config_path, 'r') as f:
                for line in f:
                    s_line = line.strip()
                    if s_line.startswith('Host ') or s_line.startswith('host '):
                        for h in s_line.split()[1:]:
                            if not any(c in h for c in '*?!'):
                                ssh_count += 1
        except Exception:
            pass

    hosts_info = get_hosts_insights()
    alerts = get_system_alerts()
    git_info = get_git_info()
    notes = get_notes()

    return {
        'user': raw_user,
        'user_display': name_display,
        'distro': distro,
        'arch': arch,
        'kernel': kernel,
        'hostname': hostname,
        'cpu_name': cpu_name,
        'core_count': core_count,
        'cpu_pct': cpu_pct,
        'cpu_temp': cpu_temp,
        'mem_total': mem_total,
        'mem_used': mem_used,
        'mem_pct': mem_pct,
        'swap_total': swap_total,
        'swap_used': swap_used,
        'swap_pct': swap_pct,
        'disk_total': disk_total,
        'disk_used': disk_used,
        'disk_pct': disk_pct,
        'load': (l1, l5, l15),
        'uptime_str': uptime_str,
        'lan_ip': lan_ip,
        'ssh_count': ssh_count,
        'hosts_active': hosts_info['active'],
        'hosts_disabled': hosts_info['disabled'],
        'hosts_active_count': hosts_info['active_count'],
        'hosts_disabled_count': hosts_info['disabled_count'],
        'alerts': alerts,
        'git_info': git_info,
        'notes': notes,
        'date_time_str': datetime.datetime.now().strftime('%a, %b %d %Y · %I:%M:%S %p')
    }

def print_mini_summary(s):
    """Outputs a 1-line compact status summary."""
    if s['hosts_active_count'] > 0:
        hosts_txt = f"{s['hosts_active_count']} active"
    elif s['hosts_disabled_count'] > 0:
        hosts_txt = f"{s['hosts_disabled_count']} off"
    else:
        hosts_txt = "default"

    temp_txt = f" ({s['cpu_temp']:.0f}°C)" if s['cpu_temp'] is not None else ""

    line = (
        f"{C_BOLD}{C_CYAN_B}✨ {s['user']}@{s['hostname']}{C_RESET} {C_SLATE}│{C_RESET} "
        f"{C_INDIGO}🐧 {s['distro']}{C_RESET} {C_SLATE}│{C_RESET} "
        f"{C_AMBER}⏱️ {s['uptime_str']}{C_RESET} {C_SLATE}│{C_RESET} "
        f"{C_EMERALD}⚡ CPU: {s['cpu_pct']:.0f}%{temp_txt}{C_RESET} {C_SLATE}│{C_RESET} "
        f"{C_EMERALD}🧠 RAM: {s['mem_used']:.1f}/{s['mem_total']:.1f}G ({s['mem_pct']:.0f}%){C_RESET} {C_SLATE}│{C_RESET} "
        f"{C_CYAN}💾 Disk: {s['disk_used']:.0f}/{s['disk_total']:.0f}G ({s['disk_pct']:.0f}%){C_RESET} {C_SLATE}│{C_RESET} "
        f"{C_INDIGO_B}🔑 SSH: {s['ssh_count']}{C_RESET} {C_SLATE}│{C_RESET} "
        f"{C_CYAN_B}🌐 Hosts: {hosts_txt}{C_RESET}"
    )
    print(line)

def print_hosts_overview(do_ping: bool = False):
    """Prints a detailed view of /etc/hosts custom entries with optional reachability check."""
    h = get_hosts_insights()
