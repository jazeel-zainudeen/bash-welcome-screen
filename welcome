def run_live_watch(interval: float = 2.0):
    """Runs a live auto-refreshing monitor loop until user presses q or Ctrl+C."""
    cfg = load_config()
    print('\033[?25l', end='')  # Hide cursor
    try:
        while True:
            # Clear screen and move to top
            print('\033[2J\033[H', end='')
            print_dashboard(cfg)
            print(f" {C_SLATE_L}Watching every {interval:.1f}s · Press {C_WHITE}Ctrl+C{C_SLATE_L} or {C_WHITE}q{C_SLATE_L} to exit{C_RESET}")
            time.sleep(interval)
    except (KeyboardInterrupt, SystemExit):
        pass
    finally:
        print('\033[?25h', end='')  # Restore cursor
        print()

def add_note(text: str):
    os.makedirs(os.path.dirname(NOTES_PATH), exist_ok=True) if os.path.dirname(NOTES_PATH) else None
    with open(NOTES_PATH, 'a') as f:
        f.write(text.strip() + '\n')
    print(f"{C_EMERALD}✓ Note added to ~/.welcome_notes:{C_RESET} {text}")

def clear_notes():
    if os.path.exists(NOTES_PATH):
        os.remove(NOTES_PATH)
    print(f"{C_EMERALD}✓ Cleared all notes from ~/.welcome_notes{C_RESET}")

def main():
    cfg = load_config()

    # CLI Argument parsing
    args = sys.argv[1:]
    
    # Handle Theme override from CLI
    for i, a in enumerate(args):
        if a in ('--theme', '-T') and i + 1 < len(args):
            selected = args[i + 1]
            if selected in THEMES:
                set_theme(selected)
                cfg['theme'] = selected
            else:
                print(f"{C_ROSE}Unknown theme '{selected}'. Available themes:{C_RESET} {', '.join(THEMES.keys())}")
                sys.exit(1)

    if 'theme' in cfg:
        set_theme(cfg['theme'])

    if '--help' in args or '-h' in args:
        print(f"{C_BOLD}{C_CYAN_B}Terminal Welcome Dashboard (welcome){C_RESET}")
        print("A fast, customizable system dashboard for interactive shell startup.\n")
        print(f"{C_BOLD}Usage:{C_RESET} welcome [OPTIONS]\n")
        print(f"{C_BOLD}Display Modes:{C_RESET}")
        print("  --mini, -m, --compact    Display a 1-line compact status summary")
        print("  --hosts, -H              Display all /etc/hosts custom entries & status")
        print("  --ping, -p               Ping test all /etc/hosts custom targets")
        print("  --watch, -w [SEC]        Run live real-time auto-refresh monitor (default 2s)")
        print("  --json, -j               Output complete system stats in JSON format\n")
        print(f"{C_BOLD}Theme & Customization:{C_RESET}")
        print(f"  --theme, -T <name>       Set color theme ({', '.join(THEMES.keys())})")
        print("  --config                 Display configuration file path and current settings\n")
        print(f"{C_BOLD}Productivity & Controls:{C_RESET}")
        print("  --note <text>            Add a quick task/reminder to ~/.welcome_notes")
        print("  --clear-notes            Clear all items in ~/.welcome_notes")
        print("  --toggle, -t <domain/ip> Quick toggle active/disabled in /etc/hosts")
        print("  --help, -h               Show this help message and exit\n")
        sys.exit(0)

    if '--config' in args:
        print(f"{C_BOLD}{C_CYAN_B}Welcome Dashboard Configuration:{C_RESET}")
        print(f"Config File : {C_WHITE}{CONFIG_PATH}{C_RESET}")
        print(f"Notes File  : {C_WHITE}{NOTES_PATH}{C_RESET}")
        print(json.dumps(cfg, indent=2))
        return

    if '--json' in args or '-j' in args:
        stats = get_system_stats()
        print(json.dumps(stats, indent=2, default=str))
        return

    if '--note' in args:
        try:
            n_idx = args.index('--note')
            if n_idx + 1 < len(args):
                add_note(' '.join(args[n_idx + 1:]))
            else:
                print(f"{C_ROSE}Error: Please specify note text. Example: welcome --note 'deploy new release'{C_RESET}")
        except Exception as e:
            print(f"{C_ROSE}Error: {e}{C_RESET}")
        return

    if '--clear-notes' in args:
        clear_notes()
        return

    if '--toggle' in args or '-t' in args:
        t_flag = '--toggle' if '--toggle' in args else '-t'
        t_idx = args.index(t_flag)
        if t_idx + 1 < len(args):
            toggle_host_entry(args[t_idx + 1])
        else:
            print(f"{C_ROSE}Error: Specify a domain or IP to toggle. Example: welcome --toggle bobcares.com{C_RESET}")
        return

    if '--hosts' in args or '-H' in args:
        do_ping = ('--ping' in args or '-p' in args)
        print_hosts_overview(do_ping=do_ping)
        return

    if '--ping' in args or '-p' in args:
        print_hosts_overview(do_ping=True)
        return

    if '--watch' in args or '-w' in args:
        w_flag = '--watch' if '--watch' in args else '-w'
        w_idx = args.index(w_flag)
        interval = 2.0
        if w_idx + 1 < len(args):
            try:
                interval = max(0.5, float(args[w_idx + 1]))
            except ValueError:
                pass
        run_live_watch(interval)
        return

    if '--mini' in args or '-m' in args or '--compact' in args:
        stats = get_system_stats()
        print_mini_summary(stats)
        return

    print_dashboard(cfg)

if __name__ == '__main__':
    main()
