def toggle_host_entry(target: str):
    """Toggles active/disabled state for a host entry in /etc/hosts."""
    if not os.path.exists('/etc/hosts'):
        print(f"{C_ROSE}Error: /etc/hosts not found.{C_RESET}")
        return

    try:
        with open('/etc/hosts', 'r') as f:
            lines = f.readlines()
    except Exception as e:
        print(f"{C_ROSE}Error reading /etc/hosts: {e}{C_RESET}")
        return

    target_clean = target.strip().lower()
    matched_idx = -1
    new_line = ""
    action = ""

    for idx, line in enumerate(lines):
        raw = line.strip()
        if not raw:
            continue
        # Check if active
        if not raw.startswith('#'):
            parts = raw.split()
            if len(parts) >= 2 and (target_clean == parts[0].lower() or target_clean in [p.lower() for p in parts[1:]]):
                matched_idx = idx
                new_line = f"# {line}"
                action = "DISABLED"
                break
        else:
            body = raw.lstrip('#').strip()
            parts = body.split()
            if len(parts) >= 2 and is_ip(parts[0]) and (target_clean == parts[0].lower() or target_clean in [p.lower() for p in parts[1:]]):
                matched_idx = idx
                new_line = body + "\n"
                action = "ACTIVATED"
                break

    if matched_idx == -1:
        print(f"{C_AMBER}No matching custom host entry found for '{target}'.{C_RESET}")
        print(f"Use '{C_WHITE}welcome --hosts{C_RESET}' to see current entries.")
        return

    lines[matched_idx] = new_line
    new_content = ''.join(lines)

    # Write using sudo tee or direct if root
    if os.geteuid() == 0:
        with open('/etc/hosts', 'w') as f:
            f.write(new_content)
        print(f"{C_EMERALD}✓ Successfully {action} host entry for '{target}'.{C_RESET}")
    else:
        p = subprocess.Popen(['sudo', 'tee', '/etc/hosts'], stdin=subprocess.PIPE, stdout=subprocess.DEVNULL)
        p.communicate(input=new_content.encode('utf-8'))
        if p.returncode == 0:
            print(f"{C_EMERALD}✓ Successfully {action} host entry for '{target}'.{C_RESET}")
        else:
            print(f"{C_ROSE}Failed to update /etc/hosts (requires sudo permissions).{C_RESET}")

